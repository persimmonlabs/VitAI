# VitAI - Environment Variables
# Copy this file to .env.local and fill in your actual values

# ===================
# Supabase Configuration
# ===================
# Get these from your Supabase project settings > API (https://app.supabase.com)
# REQUIRED: Public URL for your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# REQUIRED: Anonymous/public key (safe to expose in client-side code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# REQUIRED: Service role key (for server-side operations only)
# WARNING: Never expose this in client-side code or commit to version control
# Keep this secret and only use in API routes and server components
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===================
# OpenRouter API Configuration
# ===================
# REQUIRED: Get your API key from https://openrouter.ai/keys
# Used for AI-powered meal parsing and nutritional analysis
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Optional: Specify the AI model to use (defaults to gemini-3-pro-preview)
OPENROUTER_MODEL=google/gemini-3-pro-preview

# Optional: Your OpenRouter app name (for usage tracking)
# OPENROUTER_APP_NAME=VitAI

# Optional: Your OpenRouter app URL
# OPENROUTER_APP_URL=https://your-app-url.com

# ===================
# Application Configuration
# ===================
# REQUIRED: Base URL for the application
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Default locale (en or pt-BR)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Optional: Node environment (development, production, test)
NODE_ENV=development

# ===================
# Optional: Feature Flags
# ===================
# Enable/disable photo-based meal parsing (requires vision-capable AI model)
# NEXT_PUBLIC_ENABLE_PHOTO_PARSING=true

# Enable/disable AI-powered meal suggestions
# NEXT_PUBLIC_ENABLE_AI_SUGGESTIONS=true

# Enable/disable barcode scanning (future feature)
# NEXT_PUBLIC_ENABLE_BARCODE_SCANNING=false

# ===================
# Optional: Error Tracking (Sentry)
# ===================
# Get your DSN from https://sentry.io
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry environment (development, staging, production)
# SENTRY_ENV=development

# ===================
# Optional: Analytics
# ===================
# Google Analytics measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel Analytics (automatically enabled on Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS=true

# ===================
# Optional: Email Configuration (for notifications)
# ===================
# SMTP settings for sending email notifications
# EMAIL_SERVER_HOST=smtp.gmail.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=your-email@gmail.com
# EMAIL_SERVER_PASSWORD=your-app-password
# EMAIL_FROM=noreply@vitai.app

# ===================
# Optional: Storage Configuration
# ===================
# Maximum file upload size in MB (for meal photos)
# NEXT_PUBLIC_MAX_FILE_SIZE=10

# Allowed image formats (comma-separated)
# NEXT_PUBLIC_ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp

# ===================
# Development & Testing
# ===================
# Playwright base URL (for E2E tests)
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Skip browser launch in tests (CI/CD)
# CI=true

# Log level (error, warn, info, debug)
# LOG_LEVEL=info
