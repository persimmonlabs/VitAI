{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "@vitai-supabase-url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@vitai-supabase-anon-key",
    "SUPABASE_SERVICE_ROLE_KEY": "@vitai-supabase-service-key",
    "OPENROUTER_API_KEY": "@vitai-openrouter-key"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_SUPABASE_URL": "@vitai-supabase-url",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@vitai-supabase-anon-key",
      "SUPABASE_SERVICE_ROLE_KEY": "@vitai-supabase-service-key",
      "OPENROUTER_API_KEY": "@vitai-openrouter-key"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "/api/health"
    }
  ]
}
